# Public site URL (Docker build arg SITE_URL)
VITE_MDRIVE_WEB_SITE_URL=http://localhost:5173

# Development only: target of the Vite /api and /media proxy
VITE_MDRIVE_API_URL=http://localhost:3003

# Production container only (docker run -e / --env-file): origin nginx proxies /api and /media to
API_ORIGIN=http://localhost:3003
