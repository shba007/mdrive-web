server {
  listen 8080;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # The browser talks to this origin only. The API sends no CORS headers on /api,
  # so requests are proxied to the MDrive API (API_ORIGIN, e.g. https://api.example.com).
  location /api/ {
    proxy_pass ${API_ORIGIN};
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_ssl_server_name on;
    client_max_body_size 1m;
  }

  location /media/ {
    proxy_pass ${API_ORIGIN};
    proxy_set_header Host $proxy_host;
    proxy_ssl_server_name on;
  }

  # The service worker and manifest must always be revalidated.
  location = /sw.js {
    add_header Cache-Control "no-cache";
    try_files $uri =404;
  }

  location = /manifest.webmanifest {
    add_header Cache-Control "no-cache";
    try_files $uri =404;
  }

  # Fingerprinted build assets never change.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # Single-page app: unknown paths (deep links) fall back to index.html.
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }
}
